# Which LLM connection to use: anthropic (default) | openai-codex | openrouter
GROUNDWORK_PROVIDER=anthropic

# --- Path 1: Anthropic (default) ---
ANTHROPIC_API_KEY=sk-ant-...
# GROUNDWORK_ANTHROPIC_MODEL=claude-opus-5

# --- Path 2: ChatGPT OAuth (openai-codex) ---
# No key needed here. Run `codex login` once; Groundwork reads ~/.codex/auth.json
# and maintains its own copy in .credentials/openai-codex.json (auto-refreshed).
# GROUNDWORK_CODEX_MODEL=gpt-5.2

# --- Path 3: OpenRouter ---
OPENROUTER_API_KEY=sk-or-...
# GROUNDWORK_OPENROUTER_MODEL=anthropic/claude-opus-5
